generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("criado_em")
  albums       Album[]

  @@map("users")
}

model Album {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  titulo    String
  descricao String?
  capa      String?
  criadoEm  DateTime @default(now()) @map("criado_em")
  photos    Photo[]

  @@map("albums")
}

model SpotifyToken {
  id           Int      @id @default(1)
  refreshToken String   @map("refresh_token")
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  @@map("spotify_token")
}

model Photo {
  id              Int      @id @default(autoincrement())
  albumId         Int      @map("album_id")
  album           Album    @relation(fields: [albumId], references: [id])
  url             String
  publicId        String?  @map("public_id")
  legenda         String?
  ordem           Int      @default(0)
  spotifyTrackId  String?  @map("spotify_track_id")
  trackNome       String?  @map("track_nome")
  trackArtista    String?  @map("track_artista")
  trackPreviewUrl String?  @map("track_preview_url")
  criadoEm        DateTime @default(now()) @map("criado_em")

  @@map("photos")
}
